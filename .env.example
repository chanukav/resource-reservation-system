# PostgreSQL Connection URL for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/resource_reservation_db?schema=public"

# Cryptographic signing secret for HMAC session cookies (generate with `openssl rand -hex 32`)
AUTH_SECRET="your_cryptographic_session_secret_32_characters_minimum"
